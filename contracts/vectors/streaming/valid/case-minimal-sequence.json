{
  "schema": "streaming-case-v1.schema.json",
  "instance": {
    "case_version": 1,
    "id": "streaming/empty-prefix",
    "description": "Empty live prefix yields empty snapshot records.",
    "source": "pi",
    "group_id": "empty-prefix-group",
    "required_capabilities": [
      "stream-core",
      "stream-apply-snapshot",
      "stream-full-snapshot",
      "stream-record-delta",
      "stream-file-jsonl"
    ],
    "options": {
      "delivery": "both",
      "include_provisional": true,
      "require_complete_lines": true,
      "finalize_on_close": true,
      "reorder": "reject",
      "reset_policy": "return-reset-required"
    },
    "steps": [
      {
        "id": "snapshot-empty",
        "input": {
          "kind": "snapshot-bytes",
          "inline_utf8": "",
          "source_revision": "gen-0"
        },
        "expected": {
          "update_kind": "updated",
          "record_count": 0,
          "complete": false
        },
        "double_invoke": true
      }
    ],
    "comparison": [
      "stream-json-exact",
      "stream-cursor-exact",
      "stream-delta-apply"
    ],
    "oracle": {
      "prefix_re_normalize": true,
      "append_equals_prefix": true
    },
    "privacy": {
      "forbidden_substrings": [
        "SECRET_TOKEN_xyz",
        "/Users/real-user/.pi/agent"
      ]
    }
  }
}
