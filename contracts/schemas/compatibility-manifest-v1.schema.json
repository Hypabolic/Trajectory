{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypabolic.dev/trajectory/contracts/compatibility-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "product",
    "contracts",
    "public_schemas",
    "capabilities",
    "implemented"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "const": 1
    },
    "product": {
      "const": "Trajectory"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "package_version",
        "role"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "black-box-compatibility-oracle"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizer",
        "diagnostics",
        "conformance_protocol"
      ],
      "properties": {
        "normalizer": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "type": "string",
          "minLength": 1
        },
        "conformance_protocol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "public_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "pattern": "^schemas/.+\\.schema\\.json$"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityName"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityName"
          },
          "uniqueItems": true
        }
      }
    },
    "implemented": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "outputs"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "enum": [
              "pi",
              "claude-code",
              "codex",
              "openclaw",
              "hermes",
              "ahp",
              "grok-build"
            ]
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "capabilityName": {
      "type": "string",
      "description": "Known batch and stream capability names. stream-* names are allowed in manifests but must not be claimed implemented until the multi-runtime stream matrix (LS-12) is green.",
      "enum": [
        "normalize",
        "normalize-partial",
        "list-explicit-root",
        "typed-diagnostics",
        "typed-fatal-errors",
        "deterministic-rerun",
        "native-aot",
        "otel-sdk-emission",
        "sqlite-stores",
        "stream-core",
        "stream-cursor-v1",
        "stream-jsonl-framing",
        "stream-apply-snapshot",
        "stream-apply-append",
        "stream-full-snapshot",
        "stream-record-delta",
        "stream-reset",
        "stream-provisional-records",
        "stream-deterministic-replay",
        "stream-file-jsonl",
        "stream-ahp-snapshot",
        "stream-ahp-action-log",
        "stream-file-io",
        "stream-file-watch",
        "stream-ahp-client",
        "stream-ahp-list-sessions",
        "stream-hermes-provider",
        "stream-async-iterator"
      ]
    }
  }
}
