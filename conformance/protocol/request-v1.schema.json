{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypabolic.dev/trajectory/conformance/request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "case", "operation", "repository_root"],
  "properties": {
    "protocol_version": { "const": "1" },
    "case": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/-]*$" },
    "operation": {
      "enum": [
        "normalize-letta",
        "normalize-canonical",
        "normalize-hypabolic",
        "project-openai",
        "project-minimal-jsonl",
        "project-otel",
        "list-trajectories",
        "stream-sequence",
        "stream-replay",
        "stream-apply-append",
        "stream-apply-snapshot",
        "stream-apply-ahp-actions",
        "stream-apply-ahp-snapshot",
        "stream-finish",
        "stream-reset"
      ],
      "description": "Batch normalize/list ops plus LS-02 stream ops. stream-sequence/stream-replay run ordered multi-step streaming cases; per-step apply ops are reserved for engines (LS-04+) and may return unsupported until claimed."
    },
    "repository_root": { "type": "string", "minLength": 1 }
  }
}
