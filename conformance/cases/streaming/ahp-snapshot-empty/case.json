{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/ahp-snapshot-empty",
  "description": "Empty AHP chat snapshot (no turns) yields empty stream records.",
  "source": "ahp",
  "group_id": "ahp-chat:/00000000-0000-4000-8000-0000000000e0",
  "required_capabilities": [
    "stream-core",
    "stream-ahp-snapshot",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required",
    "ahp_protocol_version": "0.7.0"
  },
  "steps": [
    {
      "id": "empty-snapshot",
      "input": {
        "kind": "ahp-snapshot",
        "material": "step-empty.json",
        "source_revision": "ahp-rev-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "result": "expected.empty-snapshot.json"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-cursor-exact",
    "stream-delta-apply",
    "stream-idempotence"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
