{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/snapshot-delta-equivalence",
  "description": "Every updated revision includes coherent snapshot+delta; delta applied to prior equals snapshot.",
  "source": "pi",
  "group_id": "stream-snapshot-delta-equivalence",
  "required_capabilities": [
    "stream-core",
    "stream-apply-snapshot",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1",
    "stream-file-jsonl"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "snapshot-a",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-a.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false
      },
      "double_invoke": true
    },
    {
      "id": "snapshot-b",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-b.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-delta-apply",
    "stream-idempotence"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
