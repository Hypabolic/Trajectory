{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/file-compaction-reset",
  "description": "Prefix hash mismatch (compaction rewrite) requires reset (source-compacted / prefix-hash-mismatch).",
  "source": "grok-build",
  "group_id": "stream-file-compaction-reset",
  "required_capabilities": [
    "stream-core",
    "stream-apply-snapshot",
    "stream-reset",
    "stream-cursor-v1",
    "stream-file-jsonl"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "snapshot-original",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-original.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false
      },
      "double_invoke": true
    },
    {
      "id": "snapshot-compacted",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-compacted.jsonl",
        "source_revision": "gen-compact"
      },
      "expected": {
        "update_kind": "reset-required",
        "reset_reason": "source-compacted"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-cursor-exact",
    "stream-idempotence"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
