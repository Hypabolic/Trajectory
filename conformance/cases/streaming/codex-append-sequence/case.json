{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/codex-append-sequence",
  "description": "Codex JSONL: successive append-bytes chunks equal full-prefix oracle.",
  "source": "codex",
  "group_id": "stream-codex-append",
  "required_capabilities": [
    "stream-core",
    "stream-apply-append",
    "stream-jsonl-framing",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1",
    "stream-file-jsonl"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "append-session-meta",
      "input": {
        "kind": "append-bytes",
        "material": "step-1.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "result": "expected.append-session-meta.json"
      },
      "double_invoke": true
    },
    {
      "id": "append-user",
      "input": {
        "kind": "append-bytes",
        "material": "step-2.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "result": "expected.append-user.json"
      },
      "double_invoke": true
    },
    {
      "id": "append-assistant",
      "input": {
        "kind": "append-bytes",
        "material": "step-3.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "result": "expected.append-assistant.json"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-delta-apply",
    "stream-idempotence",
    "stream-oracle-parity"
  ],
  "oracle": {
    "prefix_re_normalize": true,
    "append_equals_prefix": true
  },
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
