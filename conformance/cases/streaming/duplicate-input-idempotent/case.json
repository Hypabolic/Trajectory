{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/duplicate-input-idempotent",
  "description": "Replaying the same committed append with the pre-apply cursor is idempotent (second apply → unchanged). Content equality alone does not short-circuit.",
  "source": "pi",
  "group_id": "stream-duplicate-input-idempotent",
  "required_capabilities": [
    "stream-core",
    "stream-apply-append",
    "stream-deterministic-replay",
    "stream-jsonl-framing",
    "stream-cursor-v1",
    "stream-file-jsonl"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "append-line",
      "input": {
        "kind": "append-bytes",
        "material": "step-line.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "result": "expected.append-line.json"
      },
      "double_invoke": true
    },
    {
      "id": "append-line-replay",
      "input": {
        "kind": "append-bytes",
        "material": "step-line.jsonl",
        "source_revision": "gen-0",
        "cursor": {
          "cursor_version": 1,
          "source": "pi",
          "group_id": "stream-duplicate-input-idempotent",
          "generation": 0,
          "position": {
            "kind": "byte",
            "next_byte_offset": 0,
            "pending_byte_length": 0
          },
          "source_revision": "gen-0",
          "prefix_sha256": null
        }
      },
      "expected": {
        "update_kind": "unchanged",
        "complete": false,
        "result": "expected.append-line-replay.json"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-idempotence",
    "stream-cursor-exact",
    "stream-oracle-parity"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  },
  "oracle": {
    "append_equals_prefix": true,
    "prefix_re_normalize": true
  }
}
