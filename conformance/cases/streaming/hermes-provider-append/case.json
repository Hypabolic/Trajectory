{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/hermes-provider-append",
  "description": "Core apply_hermes_export growth: first user row, then assistant append (hermes-row cursor).",
  "source": "hermes",
  "group_id": "hermes-session-stream-1",
  "required_capabilities": [
    "stream-core",
    "stream-cursor-v1",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-reset"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "export-partial",
      "input": {
        "kind": "hermes-export",
        "material": "step-partial.json",
        "source_revision": "db-1"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "record_count": 2,
        "cursor_position_kind": "hermes-row",
        "result": "expected.export-partial.json"
      },
      "double_invoke": true
    },
    {
      "id": "export-growth",
      "input": {
        "kind": "hermes-export",
        "material": "step-full.json",
        "source_revision": "db-1"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "record_count": 3,
        "cursor_position_kind": "hermes-row",
        "result": "expected.export-growth.json"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-cursor-exact",
    "stream-delta-apply",
    "stream-idempotence"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
