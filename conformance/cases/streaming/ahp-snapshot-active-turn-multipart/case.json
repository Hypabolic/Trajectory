{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/ahp-snapshot-active-turn-multipart",
  "description": "AHP multi-part activeTurn growth keeps stable provisional ids across snapshots and finalize.",
  "source": "ahp",
  "group_id": "ahp-chat:/00000000-0000-4000-8000-0000000000b2",
  "required_capabilities": [
    "stream-core",
    "stream-ahp-snapshot",
    "stream-provisional-records",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required",
    "ahp_protocol_version": "0.7.0"
  },
  "steps": [
    {
      "id": "multipart-1",
      "input": {
        "kind": "ahp-snapshot",
        "material": "step-1.json",
        "source_revision": "ahp-mp-1"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "provisional_ids": [
          "prov-active:part-md-multi-1"
        ],
        "result": "expected.step-1.json"
      },
      "double_invoke": true
    },
    {
      "id": "multipart-2",
      "input": {
        "kind": "ahp-snapshot",
        "material": "step-2.json",
        "source_revision": "ahp-mp-2"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "provisional_ids": [
          "prov-active:part-md-multi-1",
          "prov-active:tool-call-multi-1"
        ],
        "result": "expected.step-2.json"
      },
      "double_invoke": true
    },
    {
      "id": "multipart-3",
      "input": {
        "kind": "ahp-snapshot",
        "material": "step-3.json",
        "source_revision": "ahp-mp-3"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "finalized_ids": [
          "prov-active:part-md-multi-1",
          "prov-active:tool-call-multi-1"
        ],
        "result": "expected.step-3.json"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-delta-apply",
    "stream-idempotence",
    "stream-cursor-exact"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
