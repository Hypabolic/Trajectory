{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/source-group-conflict",
  "description": "Material whose native group disagrees with stream group_id yields group-changed / source_group_conflict.",
  "source": "pi",
  "group_id": "stream-expected-group",
  "required_capabilities": [
    "stream-core",
    "stream-apply-snapshot",
    "stream-reset",
    "stream-cursor-v1",
    "stream-file-jsonl"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "snapshot-matching-group",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-matching.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "result": "expected.snapshot-matching-group.json"
      },
      "double_invoke": true
    },
    {
      "id": "snapshot-foreign-group",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-foreign-group.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "reset-required",
        "reset_reason": "group-changed",
        "result": "expected.snapshot-foreign-group.json"
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-cursor-exact",
    "stream-idempotence",
    "stream-oracle-parity"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  },
  "oracle": {
    "append_equals_prefix": true,
    "prefix_re_normalize": true
  }
}
