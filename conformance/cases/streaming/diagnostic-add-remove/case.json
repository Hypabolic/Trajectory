{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/diagnostic-add-remove",
  "description": "Diagnostics appear on a malformed line then clear when the prefix is repaired.",
  "source": "pi",
  "group_id": "stream-diagnostic-add-remove",
  "required_capabilities": [
    "stream-core",
    "stream-apply-snapshot",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1",
    "stream-file-jsonl"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required"
  },
  "steps": [
    {
      "id": "snapshot-with-bad-line",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-with-diagnostic.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "diagnostic_codes": ["invalid_json_line"]
      },
      "double_invoke": true
    },
    {
      "id": "snapshot-repaired",
      "input": {
        "kind": "snapshot-bytes",
        "material": "step-repaired.jsonl",
        "source_revision": "gen-0"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "diagnostic_codes": []
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-diagnostics-by-step",
    "stream-delta-apply",
    "stream-idempotence"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
