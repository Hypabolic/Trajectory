{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/ahp-action-turn-flow",
  "description": "AHP Shape B action-log reduces turn start, delta, and complete into stable records.",
  "source": "ahp",
  "group_id": "ahp-chat:/00000000-0000-4000-8000-0000000000c1",
  "required_capabilities": [
    "stream-core",
    "stream-ahp-action-log",
    "stream-ahp-snapshot",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required",
    "ahp_protocol_version": "0.7.0"
  },
  "steps": [
    {
      "id": "actions-turn",
      "input": {
        "kind": "ahp-actions",
        "material": "step-actions.jsonl"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-delta-apply",
    "stream-idempotence",
    "stream-cursor-exact"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
