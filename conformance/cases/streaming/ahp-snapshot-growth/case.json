{
  "$schema": "../../../../contracts/schemas/streaming-case-v1.schema.json",
  "case_version": 1,
  "id": "streaming/ahp-snapshot-growth",
  "description": "Successive AHP Shape A snapshots grow from provisional activeTurn to completed turns.",
  "source": "ahp",
  "group_id": "ahp-chat:/00000000-0000-4000-8000-0000000000b1",
  "required_capabilities": [
    "stream-core",
    "stream-ahp-snapshot",
    "stream-provisional-records",
    "stream-full-snapshot",
    "stream-record-delta",
    "stream-cursor-v1"
  ],
  "options": {
    "delivery": "both",
    "include_provisional": true,
    "require_complete_lines": true,
    "finalize_on_close": true,
    "reorder": "reject",
    "reset_policy": "return-reset-required",
    "ahp_protocol_version": "0.7.0"
  },
  "steps": [
    {
      "id": "snapshot-1",
      "input": {
        "kind": "ahp-snapshot",
        "material": "step-1.json",
        "source_revision": "ahp-rev-1"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false,
        "provisional_ids": ["prov-active-turn-1"]
      },
      "double_invoke": true
    },
    {
      "id": "snapshot-2",
      "input": {
        "kind": "ahp-snapshot",
        "material": "step-2.json",
        "source_revision": "ahp-rev-2"
      },
      "expected": {
        "update_kind": "updated",
        "complete": false
      },
      "double_invoke": true
    }
  ],
  "comparison": [
    "stream-json-exact",
    "stream-delta-apply",
    "stream-idempotence",
    "stream-cursor-exact"
  ],
  "privacy": {
    "forbidden_substrings": [
      "SECRET_TOKEN_xyz",
      "/Users/real-user/",
      "sk-live-",
      "auth.json"
    ]
  }
}
