{
  "name": "@hypabolic/trajectory-otel",
  "version": "0.1.0",
  "description": "Optional deterministic OpenTelemetry GenAI projection for Trajectory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hypabolic/Trajectory.git",
    "directory": "typescript/packages/trajectory-otel"
  },
  "keywords": ["opentelemetry", "agents", "observability", "genai"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "provenance": true },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hypabolic/trajectory": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc --build --clean tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
