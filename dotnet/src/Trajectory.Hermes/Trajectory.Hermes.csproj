<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>Hypabolic.Trajectory.Hermes</AssemblyName>
    <RootNamespace>Hypabolic.Trajectory.Hermes</RootNamespace>
    <PackageId>Hypabolic.Trajectory.Hermes</PackageId>
    <Version>0.1.2</Version>
    <Description>Optional Hermes SQLite/provider streaming for Hypabolic.Trajectory (query rows; never byte-tail state.db).</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Hypabolic/Trajectory</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Optional SQLite provider: native interop is not Native AOT / trim clean. -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Trajectory/Trajectory.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <!-- Override transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 (NU1903 / CVE-2025-6965). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="package-capabilities.json" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
