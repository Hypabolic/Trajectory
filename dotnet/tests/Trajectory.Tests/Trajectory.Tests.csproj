<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JsonSchema.Net" Version="9.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Trajectory/Trajectory.csproj" />
    <ProjectReference Include="../../src/Trajectory.IO/Trajectory.IO.csproj" />
    <ProjectReference Include="../../src/Trajectory.Ahp/Trajectory.Ahp.csproj" />
    <ProjectReference Include="../../src/Trajectory.OpenTelemetry/Trajectory.OpenTelemetry.csproj" />
    <ProjectReference Include="../../src/Trajectory.Testing/Trajectory.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../conformance/cases/**/*"
          Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../contracts/compatibility.json" Link="Contracts/compatibility.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../contracts/schemas/*.json" Link="Schemas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../contracts/vectors/streaming/**/*"
          Link="ContractVectors/streaming/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../conformance/protocol/*.json" Link="ConformanceProtocol/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
